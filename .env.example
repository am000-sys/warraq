# ════════════════════════════════════════
# وَرَّاق — متغيّرات البيئة
# انسخ هذا الملفّ إلى .env.local واملأ القيم
# ════════════════════════════════════════

# ── أساسيّ (مطلوب للتشغيل) ──
# قاعدة بيانات PostgreSQL. على Supabase استعمل Transaction Pooler (المنفذ 6543)
# مع pgbouncer للبيئات serverless مثل Vercel:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# سرّ NextAuth — ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="..."
# على Vercel يُضبط تلقائياً؛ محلّياً: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# ── حساب المالك (يُستخدم في npm run db:seed فقط) ──
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="كلمة-مرور-قوية-10-أحرف-فأكثر"
SEED_ADMIN_NAME="اسمك"

# ── Mistral OCR (خدمة التفريغ النصّي الأساسيّة — مفضّلة) ──
# من: https://console.mistral.ai/api-keys
# عند ضبطها يُستخدم Mistral للتفريغ؛ وإلّا يرجع النظام إلى Claude.
MISTRAL_API_KEY="..."

# ── Claude (بديل للتفريغ + خدمات Ask/Report الإضافيّة المدفوعة) ──
# نفس المفتاح يشغّل المعالجة وخدمات Claude الإضافيّة. إعداد الإضافة (تفعيل/سعر/طريقة
# الاحتساب) يُدار من جدول SystemSetting (مفاتيح claude_addon_*) لا من البيئة.
# من: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Qwen (مزوّد مجانيّ/أرخص للملخّص الدراسي — بديل اختياريّ لـ Claude) ──
# يُستخدم فقط في ميزة «الملخّص الدراسي» عندما يضبط المالك study_model على معرّف
# يبدأ بـ qwen- (مثل qwen-plus). ميزات OCR وAsk/Report لا تتأثّر.
# من: https://bailian.console.alibabacloud.com (DashScope API Keys)
QWEN_API_KEY=""
# القاعدة الدوليّة افتراضاً؛ لقاعدة الصين: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# أقصى توكنات إخراج للنداء الواحد (المتابعة تُكمل تلقائيّاً إن بُلغ الحدّ)
QWEN_MAX_OUTPUT="8192"

# ── التخزين Cloudflare R2 (مطلوب لرفع الملفّات فعلياً) ──
# من: dash.cloudflare.com → R2 → Manage API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="warraq"

# ── إتاحة الدفع الإلكترونيّ ──
# موقوف افتراضيّاً: التحويل البنكيّ هو القناة المتاحة، والواجهة تعرض «قريباً».
# اضبطه على "1" بعد تفعيل بوّابة الدفع بمفاتيح إنتاج حقيقيّة.
CARD_PAYMENTS_ENABLED=""

# ── الدفع: Stripe (بطاقات دوليّة + Apple/Google Pay) ──
# من: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── الدفع: Tap Payments (مدى + Apple Pay سعودي + STC Pay) ──
# من: dashboard.tap.company
# مهمّ: للإنتاج استعمل مفتاح الإنتاج الذي يبدأ بـ sk_live_ — المفتاح الاختباريّ
# (sk_test_) ينجح في الموقع ويُضيف الرصيد لكنّه لا يُحصّل مالاً ولا يظهر في لوحة Tap.
TAP_SECRET_KEY=""

# رابط إشعار Tap (post.url) — اتركه فارغاً ليُشتقّ من NEXTAUTH_URL.
# اضبطه صراحةً إن كان النطاق العامّ يختلف عن نطاق الطلب.
TAP_WEBHOOK_URL=""

# حارس: يُعطَّل الدفع بالبطاقة تلقائيّاً على الإنتاج إن كان مفتاح Tap اختباريّاً،
# لأنّ عمليّاته لا تصل حساب التاجر. اضبطه على "1" للتجاوز عمداً (غير موصى به).
TAP_ALLOW_TEST_IN_PRODUCTION=""

# سعر الصفحة في الدفع لمرّة واحدة (بالهللات) — افتراضي ٣١ هللة
PAYG_PRICE_HALALA="31"

# ── البريد Resend (اختياري — لاستعادة كلمة المرور وإشعارات المالك) ──
RESEND_API_KEY=""

# بريد المالك لإشعارات طلبات الشحن العاجلة (يقبل عدّة عناوين مفصولة بفاصلة).
# اتركه فارغاً ليُستعمل البريد المثبَّت في src/lib/email.ts.
OWNER_NOTIFY_EMAIL=""

# عنوان الردّ على الرسائل (اختياري). رسالة من noreply لا تُردّ عليها تبدو أقلّ
# مصداقيّة لدى مرشِّحات الإزعاج — اضبطه على بريد يُقرأ فعلاً.
EMAIL_REPLY_TO=""
EMAIL_FROM="warraq <noreply@yourdomain.com>"

# ── الملخّص الدراسي ──
# موقوف افتراضيّاً ويعرض «قريباً». اضبطه على "1" بعد تهيئة مزوّد عامل.
STUDY_ENABLED=""

# النموذج الافتراضي (لا توجد واجهة لتحرير SystemSetting، فيُضبط من هنا).
# يُقبل: claude-* أو qwen-* أو kimi-*/moonshot-*.
# الموصى به لكتاب كامل في نداء واحد: "kimi-k3" (نافذة ١ مليون توكن).
# ملاحظة: moonshot-v1-* وkimi-k2.5 متقاعدة لدى المزوّد وتعيد 404.
STUDY_DEFAULT_MODEL=""
STUDY_DEFAULT_MODEL_PREMIUM=""

# ── مزوّد Kimi (Moonshot AI) للملخّص الدراسي ──
# من: platform.moonshot.ai
MOONSHOT_API_KEY=""
# القاعدة العالميّة افتراضاً؛ لقاعدة الصين: https://api.moonshot.cn/v1
MOONSHOT_BASE_URL=""
# سقف الإخراج (توكِنات) — افتراضي ١٣١٠٧٢ (افتراضيّ Moonshot نفسه).
# السقف الفعليّ = نافذة النموذج ناقص توكنات المُدخَل، فاخفضه مع نموذج بنافذة أضيق.
KIMI_MAX_OUTPUT=""
# مستوى التفكير (kimi-k3): "low" أرخص وكافٍ للتلخيص والاستخراج. يُرسل عند ضبطه فقط.
KIMI_REASONING_EFFORT=""
# نافذة السياق للنماذج غير المعروفة لدى الكود (توكِنات) — افتراضي ٢٦٢١٤٤.
# kimi-k3 معروفة (١٠٤٨٥٧٦) فلا تحتاج ضبطاً. يُستعمل لحساب ميزانيّة الإخراج
# (أقصى إخراج = النافذة ناقص المُدخَل) ولرفض مادّة أكبر من النافذة قبل أيّ كلفة.
KIMI_CONTEXT_WINDOW=""

# لحظة القطع لتفعيل الحسابات السابقة عبر /api/admin/verify-legacy-users
# (الحسابات المُنشأة قبلها تُعدّ مفعَّلة). اتركه فارغاً للافتراضيّ.
EMAIL_VERIFY_CUTOFF=""

# ── الدخول بحساب Google (اختياري) ──
# من: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# نوع التطبيق: Web application
# Authorized redirect URI: https://<نطاقك>/api/auth/callback/google
# يظهر زرّ Google في صفحتي الدخول والتسجيل فقط عند ضبط المفتاحين معاً.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── تحدٍّ بشريّ على التسجيل: Cloudflare Turnstile (اختياريّ، مجّانيّ) ──
# من: dash.cloudflare.com → Turnstile → Add site (اختر Managed)
# يُوقف الإغراق الآليّ الموزَّع الذي لا يوقفه حدّ المعدّل حسب الـ IP وحده.
# **موقوف ما لم يُضبط المفتاحان معاً** — عندها لا تُعرض أداة ولا يُفحص شيء،
# وسلوك الموقع مطابق تماماً لما قبله.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
